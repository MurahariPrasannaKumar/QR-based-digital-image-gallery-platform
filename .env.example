# --- Server-only secrets: never prefix any of these with NEXT_PUBLIC_ ---

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_gallery?schema=public"

AUTH_SECRET="replace-with-a-secure-random-secret"

# Optional in development — if SMTP_HOST is unset, the app sends email
# through a disposable Ethereal test inbox and logs a preview URL instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="QR Gallery <no-reply@yourdomain.com>"

# Cloudflare R2 (S3-compatible object storage for image files).
# R2_ACCOUNT_ID is used in production to derive the endpoint
# (https://<account-id>.r2.cloudflarestorage.com). For local development
# against MinIO (or another S3-compatible endpoint) instead, set
# R2_ENDPOINT directly and leave R2_ACCOUNT_ID blank.
R2_ACCOUNT_ID=""
R2_ENDPOINT=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
# Optional: a public bucket domain (R2 custom domain or r2.dev URL) used as
# a fast path for viewing images in PUBLIC galleries. Safe to expose since
# it only ever points at objects you've already made public — private/
# password-protected galleries always use short-lived signed URLs instead,
# regardless of this setting.
R2_PUBLIC_URL=""

# --- Client-safe: exposed to the browser, must never hold a secret ---

NEXT_PUBLIC_APP_URL="http://localhost:3000"

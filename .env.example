# --- Server-only secrets: never prefix any of these with NEXT_PUBLIC_ ---

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/qr_gallery?schema=public"

# Signs the password-protected-gallery access cookie only (user
# authentication is handled entirely by Firebase Auth — see below).
AUTH_SECRET="replace-with-a-secure-random-secret"

# Firebase Admin SDK (server-only) — verifies session cookies and looks up
# users. From the Firebase Console: Project Settings -> Service Accounts ->
# Generate new private key. That JSON file has project_id/client_email/
# private_key — copy them here (FIREBASE_PRIVATE_KEY keeps its \n sequences
# literally, e.g. "-----BEGIN PRIVATE KEY-----\nMII...\n-----END...-----\n").
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Supabase Storage (S3-compatible object storage for image files).
# Get these from the Supabase dashboard: Project Settings -> Storage ->
# S3 Connection ("Connect" button, S3 tab). Create an access key there
# (this is separate from your Supabase API keys).
SUPABASE_S3_ENDPOINT=""
SUPABASE_S3_REGION=""
SUPABASE_S3_ACCESS_KEY_ID=""
SUPABASE_S3_SECRET_ACCESS_KEY=""
SUPABASE_STORAGE_BUCKET=""
# Optional: the public URL base for the bucket (only if the bucket is set
# to Public in Supabase Storage settings), used as a fast path for viewing
# images in PUBLIC galleries. Safe to expose since it only ever points at
# objects you've already made public — private/password-protected
# galleries always use short-lived signed URLs instead, regardless of this
# setting. Format: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket-name>
SUPABASE_PUBLIC_URL=""

# --- Client-safe: exposed to the browser, must never hold a secret ---

NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Firebase client SDK config. From the Firebase Console: Project Settings ->
# General -> Your apps -> Web app (create one if you haven't). These are
# safe to expose — Firebase enforces access via its own security rules, not
# by keeping this config secret.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyB9YUbRWwf34Qg_Crj91eav-HJ6dGXRUbg"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="ctrl-fake-17d3b.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="ctrl-fake-17d3b"
NEXT_PUBLIC_FIREBASE_APP_ID="1:403336913751:web:0c8592db55a988dc0d1412"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="403336913751"
